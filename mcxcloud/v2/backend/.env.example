# Copy to .env and adjust. Loaded by the process environment, e.g.
#   node --env-file=.env src/server.js   (Node 20+)
PORT=8080
# bind localhost only when workers reach the API via the HTTPS proxy (recommended, below);
# use 0.0.0.0 only if workers connect straight to this port on the LAN
HOST=127.0.0.1
DATABASE_URL=postgres://mcxcloud@localhost/mcxcloud
CORS_ORIGIN=https://mcx.space
BLOB_THRESHOLD=4096

# --- scheduler / worker (Phase 3) ---
# run the queue consumer that dispatches to Docker Swarm (set 0 to run API-only)
RUN_SCHEDULER=1
# API base URL as reachable FROM INSIDE a swarm container. Prefer the public HTTPS proxy
# endpoint (Apache -> 127.0.0.1:8080), so the API port need not be exposed on the LAN:
WORKER_API_URL=https://your-manager.example.edu/api
#   (alternative: http://<manager-LAN-IP>:8080 with HOST=0.0.0.0 — exposes the port)
# docker image for the mcx worker (needs bash + wget or curl)
WORKER_IMAGE=fangqq/mcx:v2025.10
# hard cap per simulation (ms) before the job is killed
MAX_RUNTIME_MS=60000
# max concurrent simulations; 0 = auto-detect from swarm GPU count
MAX_CONCURRENT=0
# shared secret the worker presents (x-worker-secret) for input/output/complete
WORKER_SECRET=change-me
# purge non-library jobs (and GC their orphaned outputs) older than this; library-linked
# results are kept forever (permanent cache)
JOB_TTL_MS=3600000
# minimum gap between submissions from one client IP (guards against accidental bursts)
MIN_SUBMIT_GAP_MS=5000
# secret for the library review/admin API. Generate with:  openssl rand -hex 32
# Leave empty to DISABLE the admin API entirely. Never commit the real value.
ADMIN_SECRET=

# --- LLM: natural-language prompt -> MCX input JSON (the "LLM" tab) ---
# 1 enables POST /llm/generate; anything else disables it and hides the tab in the UI.
LLM_ENABLED=0
# Interpreter that has MCXLLM's dependencies (langchain, openai, pydantic) — NOT the
# system python. e.g. ~/miniconda3/envs/LLM_mcx/bin/python
LLM_PYTHON=python3
# Directory containing LLMMCX_gpt4o.py + LLMJson_post_gpt4o.py (imported, not copied).
LLM_MCX_DIR=
# Hard cap on one conversion (a gpt-4o call is ~6 s; the langchain import adds ~2 s).
LLM_TIMEOUT_MS=120000
# Minimum gap between generate calls from one client IP — each call spends a model request.
LLM_MIN_GAP_MS=10000
#
# Backends. The UI offers every configured (backend, model) pair in a dropdown and sends
# the chosen one per request; LLM_BACKEND + LLM_DEFAULT_MODEL only pick which is preselected
# (an unknown LLM_DEFAULT_MODEL falls back to that backend's first model).
#   ollama — LLM_OLLAMA_URL is the FULL OpenAI-style chat URL, e.g. the lab's public proxy
#              https://neurojson.io/api/v1/ollama-public/chat
#            or a raw ollama host, http://host:11434/v1 (/chat/completions is appended).
#            Leave empty to hide it. Note the neurojson proxy serves one fixed model
#            (qwen3.8:27b) whatever "model" a request names, so list only that one.
#   openai — bring-your-own-key: the user types their OpenAI key in the LLM tab and it is
#            used for that request only. The server's OPENAI_API_KEY is NEVER used (it is
#            stripped from the bridge's environment). Set LLM_OPENAI_MODEL= (empty) to hide it.
LLM_BACKEND=ollama
LLM_DEFAULT_MODEL=qwen3.8:27b
LLM_OPENAI_MODEL=gpt-4o
LLM_OLLAMA_URL=
# Comma-separated; each becomes its own entry in the dropdown, so several local models can
# be compared from the browser.
LLM_OLLAMA_MODELS=
