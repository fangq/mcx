# Copy to .env and adjust. Loaded by the process environment, e.g.
#   node --env-file=.env src/server.js   (Node 20+)
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://mcxcloud@localhost/mcxcloud
CORS_ORIGIN=https://mcx.space
BLOB_THRESHOLD=4096

# --- scheduler / worker (Phase 3) ---
# run the pg-boss consumer that dispatches to Docker Swarm (set 0 to run API-only)
RUN_SCHEDULER=1
# API base URL as reachable from INSIDE a swarm container (manager host/IP, not localhost)
WORKER_API_URL=http://mcx-manager:8080
# docker image for the mcx worker
WORKER_IMAGE=fangqq/mcx:v2024.2
# hard cap per simulation (ms) before the job is killed
MAX_RUNTIME_MS=60000
# max concurrent simulations; 0 = auto-detect from swarm GPU count
MAX_CONCURRENT=0
# shared secret the worker presents (x-worker-secret) for input/output/complete
WORKER_SECRET=change-me
