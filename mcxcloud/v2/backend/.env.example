# Copy to .env and adjust. Loaded by the process environment (no dotenv dependency;
# use `node --env-file=.env src/server.ts` on Node 20+, or export these vars).
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://mcxcloud@localhost/mcxcloud
CORS_ORIGIN=https://mcx.space
BLOB_THRESHOLD=4096
# shared secret the mcx worker container presents to POST /jobs/:id/complete (Phase 3)
WORKER_SECRET=change-me
