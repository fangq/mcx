# Copy to .env and adjust. Loaded by the process environment, e.g.
#   node --env-file=.env src/server.js   (Node 20+)
PORT=8080
# bind localhost only when workers reach the API via the HTTPS proxy (recommended, below);
# use 0.0.0.0 only if workers connect straight to this port on the LAN
HOST=127.0.0.1
DATABASE_URL=postgres://mcxcloud@localhost/mcxcloud
CORS_ORIGIN=https://mcx.space
BLOB_THRESHOLD=4096

# --- scheduler / worker (Phase 3) ---
# run the queue consumer that dispatches to Docker Swarm (set 0 to run API-only)
RUN_SCHEDULER=1
# API base URL as reachable FROM INSIDE a swarm container. Prefer the public HTTPS proxy
# endpoint (Apache -> 127.0.0.1:8080), so the API port need not be exposed on the LAN:
WORKER_API_URL=https://your-manager.example.edu/api
#   (alternative: http://<manager-LAN-IP>:8080 with HOST=0.0.0.0 — exposes the port)
# docker image for the mcx worker (needs bash + wget or curl)
WORKER_IMAGE=fangqq/mcx:v2025.10
# hard cap per simulation (ms) before the job is killed
MAX_RUNTIME_MS=60000
# max concurrent simulations; 0 = auto-detect from swarm GPU count
MAX_CONCURRENT=0
# shared secret the worker presents (x-worker-secret) for input/output/complete
WORKER_SECRET=change-me
# purge non-library jobs (and GC their orphaned outputs) older than this; library-linked
# results are kept forever (permanent cache)
JOB_TTL_MS=3600000
# minimum gap between submissions from one client IP (guards against accidental bursts)
MIN_SUBMIT_GAP_MS=5000
# secret for the library review/admin API. Generate with:  openssl rand -hex 32
# Leave empty to DISABLE the admin API entirely. Never commit the real value.
ADMIN_SECRET=
